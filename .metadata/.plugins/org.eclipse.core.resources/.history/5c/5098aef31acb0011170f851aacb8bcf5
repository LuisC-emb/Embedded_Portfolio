//Enable the RCC clock for the selected GPIO port
void gpio_clock_enable(GPIO_TypeDef *port) {
	if (port == GPIOA)           RCC->AHB1ENR |= (0x1U << 0);
	else if (port == GPIOB)      RCC->AHB1ENR |= (0x1U << 1);
	else if (port == GPIOC)      RCC->AHB1ENR |= (0x1U << 2);
	else if (port == GPIOH)      RCC->AHB1ENR |= (0x1U << 7);
}





///////////@@ 1. Configure a pin as input mode
void gpio_init_input(GPIO_TypeDef *port, uint8_t pin, GPIO_Pupd_t pull_type){
	//1. Enable the clock of port
	gpio_clock_enable(port);

	//2. Configure MODER as 00 (Input mode)
	port->MODER &= ~(0x3U << (pin * 2));
	port->MODER |= (GPIO_MODE_INPUT << (pin * 2));

	//3. Configure PUPDR (None, Pull-up or pull-down)
	port->PUPDR &= ~(0x3U << (pin * 2));
	port->PUPDR |= ((uint32_t)pull_type << (pin*2));
}




///////////@@ 2. Configure a pin as output mode
void gpio_init_output (GPIO_TypeDef *port, uint8_t pin, GPIO_Otype_t output_type, GPIO_Pupd_t pull_type){
	//1. Enable the clock of port
	gpio_clock_enable(port);

	//2. Configure MODER as 01 (Output mode)
	port->MODER &= ~(0x3U << (pin * 2));
	port->MODER |= (GPIO_MODE_OUTPUT << (pin * 2));

	//3. Configure OTYPER (Push-Pull / Open-Drain)
	if (output_type == GPIO_OTYPE_OPENDRAIN) {
		port->OTYPER |= (0x1U << pin);
	} else {
		port->OTYPER &= ~(0x1U << pin);
	}

	//4. Configure PUPDR
	port->PUPDR &= ~(0x3U << (pin * 2));
	port->PUPDR |= ((uint32_t)pull_type << (pin * 2));

}





///////////@@ 3. Configure a pin as alternate function mode
void gpio_init_alt_function(GPIO_TypeDef *port, uint8_t pin, uint8_t alt_func, GPIO_Otype_t output_type, GPIO_Pupd_t pull_type, GPIO_Speed_t speed) {
	//1. Enable the clock of port
	gpio_clock_enable(port);

	//2. Configure MODER as 10 (Alternate function mode)
	port->MODER &= ~(0x3U << (pin * 2));
	port->MODER |= (0x2U << (pin * 2));

	//3. Configure OTYPER (Push-Pull / Open-Drain)
	if (output_type == GPIO_OTYPE_OPENDRAIN) {
		port->OTYPER |= (0x1U << pin);
	} else {
		port->OTYPER &= ~(0x1U << pin);
	}

	//4. Configure OSPEEDR (Speed)
	port->OSPEEDR &= ~(0x3U << (pin * 2));
	port->OSPEEDR |= ((uint32_t)speed << (pin * 2));

	//5. Configure PUPDR
	port->PUPDR &= ~(0x3U << (pin * 2));
	port->PUPDR |= ((uint32_t)pull_type << (pin * 2));

	//6. Configure AFR low (pins 0-7) or AFR high (pins 8-15)
	if (pin < 8) {
		port->AFRL[0] &= ~(0xFU << (pin * 4));
		port->AFRL[0] |= ((uint32_t)alt_func << (pin * 4));
	} else {
		port->AFRL[1] &= ~(0xFU << ((pin - 8) * 4));
		port->AFRL[1] |= ((uint32_t)alt_func << ((pin - 8) * 4));
	}
}





///////////@@ 4. Write state (HIGH/LOW) to a specific pin using BSRR for atomicity
void gpio_write_pin(GPIO_TypeDef *port, uint8_t pin, uint8_t state) {
	if (state) {
		port->BSRR = (0x1U << pin);        // Set pin HIGH
	} else {
		port->BSRR = (0x1U << (pin + 16)); // Reset pin LOW
	}
}





///////////@@ 5. Toggle the state of a specific pin
void gpio_toggle_pin(GPIO_TypeDef *port, uint8_t pin) {
	port->ODR ^= (0x1U << pin);
}





///////////@@ 6. Read the logic level of a specific pin from IDR
uint8_t gpio_read_pin(GPIO_TypeDef *port, uint8_t pin) {
	if ((port->IDR & (0x1U << pin)) != 0U) {
		return 1U;
	} else {
		return 0U;
	}
}






